<div class="categorias-sidebar">
    <button class="btn categorias-toggle d-md-none w-100 d-flex justify-content-between align-items-center" type="button" data-bs-toggle="collapse" data-bs-target="#categoriasCollapse">
        <span class="fw-bold" style="color:#e8632b;"><i class="bi bi-list"></i> Categorías</span>
        <i class="bi bi-chevron-down"></i>
    </button>

    <h6 class="fw-bold mb-3 d-none d-md-block" style="color:#e8632b;">Categorías</h6>

    <div class="collapse d-md-block" id="categoriasCollapse">
        <ul class="list-unstyled mb-0 mt-3 mt-md-0">
            {% for categoria in categoriasMenu() %}
                <li>
                    <a href="{{ path('app_catalogo', {categoria: categoria.id}) }}" class="categoria-link">
                        {{ categoria.nombre }}
                    </a>
                </li>
            {% else %}
                <li class="text-muted small">Sin categorías aún</li>
            {% endfor %}
        </ul>
    </div>
</div>
<style>
    .categorias-toggle {
        border: none;
        background: transparent;
        padding: 0;
    }
    .categorias-sidebar {
        background: #fff;
        border-radius: 14px;
        padding: 1.2rem;
        box-shadow: 0 2px 10px rgba(0,0,0,.05);
    }
    .categoria-link {
        display: block;
        color: #444;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
        padding: 0.5rem 0.3rem;
        border-radius: 8px;
        transition: background-color .15s ease, color .15s ease;
    }
    .categoria-link:hover {
        background-color: rgba(232, 99, 43, 0.15);
        color: #e8632b;
    }
</style>