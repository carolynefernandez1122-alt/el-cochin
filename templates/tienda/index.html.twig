{% extends 'base.html.twig' %}

{% block title %}El Cochin - Tu tienda de abarrotes{% endblock %}

{% block body %}
    <div class="container my-5">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <h2 class="fw-bold mb-0" style="color:#e8632b;">🔥 Productos Destacados</h2>
            <a href="{{ path('app_catalogo') }}" class="btn btn-outline-dark rounded-pill px-4">
                Ver todos los productos →
            </a>
        </div>

        <div class="row">
            <div class="col-12 col-md-3 mb-4">
                {% include 'tienda/_categorias_sidebar.html.twig' %}
            </div>
            <div class="col-12 col-md-8 mb-4">
                <div id="resultadosProductos" data-context="home">
                    {% include 'tienda/_lista.html.twig' with { productos: productos } %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}