{# templates/tienda/_lista.html.twig #}

<div class="row g-3">
    {% for producto in productos %}
        <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
            <div class="card h-100 shadow-sm border-0 position-relative">

                <a href="{{ path('app_producto_publico_show', {'id': producto.id}) }}" class="text-decoration-none text-reset">
                    {% if producto.imagenUrl %}
                        <img src="{{ asset('uploads/productos/' ~ producto.imagenUrl) }}" class="card-img-top" alt="{{ producto.nombre }}" style="height:180px; object-fit:cover; border-radius:14px 14px 0 0;">
                    {% else %}
                        <div class="d-flex align-items-center justify-content-center bg-light" style="height:180px; border-radius:14px 14px 0 0;">
                            <span class="text-muted small">Sin imagen</span>
                        </div>
                    {% endif %}

                    <div class="card-body">
                        <h6 class="card-title fw-semibold mb-1">{{ producto.nombre }}</h6>
                        <p class="text-muted small mb-2" style="min-height:2.5em;">
                            {{ producto.descripcion|length > 60 ? producto.descripcion|slice(0, 60) ~ '...' : producto.descripcion }}
                        </p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold" style="color:#e8632b;">{{ producto.precio }} €</span>
                            {% if producto.activo %}
                                <span class="badge bg-success">Disponible</span>
                            {% else %}
                                <span class="badge bg-secondary">Agotado</span>
                            {% endif %}
                        </div>
                    </div>
                </a>
            </div>
        </div>
    {% else %}
        <div class="col-12 text-center py-5">
            {% if q is defined and q %}
                <p class="text-muted fs-5">No encontramos productos para "<strong>{{ q }}</strong>"</p>
            {% else %}
                <p class="text-muted fs-5">Aún no hay productos disponibles.</p>
            {% endif %}
        </div>
    {% endfor %}
    {% if totalPaginas is defined and totalPaginas > 1 %}
        <nav class="mt-5 d-flex justify-content-center">
            <ul class="pagination">
                <li class="page-item {{ paginaActual == 1 ? 'disabled' : '' }}">
                    <a class="page-link" href="{{ path('app_catalogo', {page: paginaActual - 1, categoria: categoriaId|default(null)}) }}">Anterior</a>
                </li>

                {% for i in 1..totalPaginas %}
                    <li class="page-item {{ i == paginaActual ? 'active' : '' }}">
                        <a class="page-link" href="{{ path('app_catalogo', {page: i, categoria: categoriaId|default(null)}) }}" style="{{ i == paginaActual ? 'background-color:#e8632b; border-color:#e8632b;' : '' }}">
                            {{ i }}
                        </a>
                    </li>
                {% endfor %}

                <li class="page-item {{ paginaActual == totalPaginas ? 'disabled' : '' }}">
                    <a class="page-link" href="{{ path('app_catalogo', {page: paginaActual + 1, categoria: categoriaId|default(null)}) }}">Siguiente</a>
                </li>
            </ul>
        </nav>
    {% endif %}
</div>