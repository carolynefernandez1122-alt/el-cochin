<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}El Cochin - Tienda de Abarrotes{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; background-color: #fdf8f0; }
        .navbar-brand { font-weight: 800; font-size: 1.6rem; color: #e8632b !important; }
        .btn-cochin { background-color: #e8632b; border-color: #e8632b; color: white; font-weight: 600; }
        .btn-cochin:hover { background-color: #c94f1e; border-color: #c94f1e; color: white; }
        .dropdown-menu { border-radius: 12px; border: none; box-shadow: 0 6px 20px rgba(0,0,0,.12); }
        .search-form input { border-radius: 20px 0 0 20px; }
        .search-form button { border-radius: 0 20px 20px 0; }
        .card { border-radius: 14px; transition: transform .15s ease; }
        .card:hover { transform: translateY(-4px); }
        footer { background-color: #2b1c14; }
        .categorias-tabs {
            display: flex;
            gap: 1.5rem;
            overflow-x: auto;
            white-space: nowrap;
            border-top: 1px solid #f0e6da;
            padding-top: 0.6rem;
            padding-bottom: 0.6rem;
            scrollbar-width: thin;
            -webkit-overflow-scrolling: touch;
            position: relative;
            mask-image: linear-gradient(to right, black 92%, transparent 100%);
            -webkit-mask-image: linear-gradient(to right, black 92%, transparent 100%);
        }
        .categorias-tabs::-webkit-scrollbar {
            height: 4px;
        }

        @media (max-width: 576px) {
            .categorias-tabs {
                gap: 1rem;
                padding-left: 1rem;
                padding-right: 1rem;
            }
            .categoria-tab {
                font-size: 0.8rem;
            }
        }.categoria-tab {
             color: #555;
             text-decoration: none;
             font-weight: 600;
             font-size: 0.9rem;
             padding-bottom: 4px;
             border-bottom: 2px solid transparent;
             transition: color .15s ease, border-color .15s ease;
         }
        .categoria-tab:hover {
            color: #e8632b;
            border-color: #e8632b;
        }
        .categoria-tab.active {
            color: #e8632b;
            border-color: #e8632b;
        }

    </style>
</head>

<body class="d-flex flex-column min-vh-100">
<nav class="bg-white shadow-sm sticky-top">
    <div class="d-flex align-items-center px-4 py-3">
        <a class="navbar-brand" href="{{ path('app_home') }}" style="display: flex; align-items: center; gap: 8px;">
            <img src="{{ asset('images/tendero.png') }}" alt="El Cochin" width="32" height="32">
            El Cochin
        </a>

        <form id="searchForm" class="d-flex search-form flex-grow-1 mx-3" style="max-width: 420px;" action="{{ path('app_producto_buscar') }}" method="get">
            <input id="searchInput" class="form-control" type="search" name="q" placeholder="Buscar productos..." value="{{ q|default('') }}" autocomplete="off">
            <button class="btn btn-cochin" type="submit"><i class="bi bi-search"></i></button>
        </form>
    </div>

    <div class="categorias-tabs px-4">
        {% for categoria in categoriasMenu() %}
            <a href="{{ path('app_categoria_show', {id: categoria.id}) }}" class="categoria-tab">
                {{ categoria.nombre }}
            </a>
        {% else %}
            <span class="categoria-tab text-muted">Sin categorías aún</span>
        {% endfor %}
    </div>
</nav>
{% block body %}{% endblock %}

<footer class="text-white text-center py-4 mt-auto">
    <small>&copy; {{ "now"|date("Y") }} El Cochin — Tu tienda de abarrotes de confianza</small>
</footer>
<script src="{{ asset('js/search.js') }}"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>