{{ form_start(form, {attr: {novalidate: 'novalidate', enctype: 'multipart/form-data'}}) }}

<div class="mb-4">
    <h6 class="text-uppercase text-muted small fw-bold mb-3">Información general</h6>
    <div class="row g-3">
        <div class="col-12 col-md-8">
            {{ form_label(form.nombre, 'Nombre') }}
            {{ form_widget(form.nombre, {attr: {class: 'form-control'}}) }}
            <div class="campo-errores">
                {{ form_errors(form.nombre) }}
            </div>
        </div>
        <div class="col-12 col-md-4">
            {{ form_label(form.categoria, 'Categoría') }}
            {{ form_widget(form.categoria, {attr: {class: 'form-select'}}) }}
            <div class="campo-errores">
                {{ form_errors(form.categoria) }}
            </div>
        </div>
        <div class="col-12">
            {{ form_label(form.descripcion, 'Descripción') }}
            {{ form_widget(form.descripcion, {attr: {class: 'form-control', rows: 3}}) }}
            <div class="campo-errores">
                {{ form_errors(form.descripcion) }}
            </div>
        </div>
    </div>
</div>

<hr class="my-4">

<div class="mb-4">
    <h6 class="text-uppercase text-muted small fw-bold mb-3">Precio e inventario</h6>
    <div class="row g-3">
        <div class="col-6 col-md-4">
            {{ form_label(form.precio, 'Precio (€)') }}
            {{ form_widget(form.precio, {attr: {class: 'form-control'}}) }}
            <div class="campo-errores">
                {{ form_errors(form.precio) }}
            </div>
        </div>
        <div class="col-6 col-md-4">
            {{ form_label(form.stock, 'Stock') }}
            {{ form_widget(form.stock, {attr: {class: 'form-control'}}) }}
            <div class="campo-errores">
                {{ form_errors(form.stock) }}
            </div>
        </div>
    </div>
</div>

<hr class="my-4">

<div class="mb-4">
    <h6 class="text-uppercase text-muted small fw-bold mb-3">Imagen</h6>
    <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center gap-3">
        {% if imagenActual|default(null) %}
            <img src="{{ asset('uploads/productos/' ~ imagenActual) }}" alt="Imagen actual" class="rounded border flex-shrink-0" style="width: 72px; height: 72px; object-fit: cover;">
        {% else %}
            <div class="rounded border d-flex align-items-center justify-content-center flex-shrink-0 bg-light" style="width: 72px; height: 72px;">
                <i class="bi bi-image text-muted fs-4"></i>
            </div>
        {% endif %}
        <div class="flex-grow-1 w-100">
            {{ form_widget(form.imagenFile, {attr: {class: 'form-control'}}) }}
            <div class="campo-errores">
                {{ form_errors(form.imagenFile) }}
            </div>
            <div class="form-text">{{ imagenActual|default(null) ? 'Sube un archivo solo si quieres reemplazar la imagen actual.' : 'Formatos permitidos: jpg, png, webp. Máx 2MB.' }}</div>
        </div>
    </div>
</div>

<hr class="my-4">

<div class="mb-4">
    <h6 class="text-uppercase text-muted small fw-bold mb-3">Estado</h6>
    <div class="row g-3">
        <div class="col-6">
            <div class="form-check form-switch">
                {{ form_widget(form.activo, {attr: {class: 'form-check-input'}}) }}
                {{ form_label(form.activo, 'Activo', {label_attr: {class: 'form-check-label'}}) }}
            </div>
            <div class="campo-errores">
                {{ form_errors(form.activo) }}
            </div>
        </div>
        <div class="col-6">
            <div class="form-check form-switch">
                {{ form_widget(form.destacado, {attr: {class: 'form-check-input'}}) }}
                {{ form_label(form.destacado, 'Destacado', {label_attr: {class: 'form-check-label'}}) }}
            </div>
            <div class="campo-errores">
                {{ form_errors(form.destacado) }}
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-column-reverse flex-sm-row gap-2 pt-2 border-top">
    <a href="{{ path('app_producto_index') }}" class="btn btn-outline-secondary">Cancelar</a>
    <button class="btn btn-cochin">
        <i class="bi bi-check-lg"></i> Guardar
    </button>
</div>

{{ form_end(form) }}
<style>
    .campo-errores ul {
        list-style: none;
        padding: 0;
        margin: 0.25rem 0 0;
    }

    .campo-errores li {
        color: #dc3545;
        font-size: 0.875rem;
    }
</style>