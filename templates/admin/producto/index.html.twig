{% extends 'base.html.twig' %}

{% block title %}Nuestros Productos{% endblock %}

{% block body %}
    <div id="resultadosProductos">
        {% include 'tienda/_lista.html.twig' with { productos: productos } %}
    </div>
    <div class="container my-5">

        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <h2 class="fw-bold mb-0" style="color:#e8632b;">🛒 Nuestros Productos</h2>
            <a href="{{ path('app_producto_new') }}" class="btn btn-cochin rounded-pill px-4">
