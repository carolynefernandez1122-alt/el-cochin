{% extends 'base.html.twig' %}

{% block title %}Productos{% endblock %}

{% block body %}
    <div class="container py-4" style="max-width: 900px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h4 mb-0">Productos</h1>
                <p class="text-muted small mb-0">Gestiona el catálogo de la tienda</p>
            </div>
            <a href="{{ path('app_producto_new') }}" class="btn btn-cochin">
                <i class="bi bi-plus-lg"></i> Nuevo producto
            </a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                    <tr>
                        <th class="ps-3 sortable" data-sort="number" data-col="0">
                            Id <i class="bi bi-arrow-down-up text-muted small"></i>
                        </th>
                        <th class="sortable" data-sort="text" data-col="1">
                            Nombre <i class="bi bi-arrow-down-up text-muted small"></i>
                        </th>
                        <th class="sortable" data-sort="number" data-col="2">
                            Precio <i class="bi bi-arrow-down-up text-muted small"></i>
                        </th>
                        <th class="text-end pe-3">Acciones</th>
                    </tr>
                    </thead>
                    <tbody id="tabla-productos-body">
                    {% for producto in productos %}
                        <tr>
                            <td class="ps-3 text-muted" data-value="{{ producto.id }}">{{ producto.id }}</td>
                            <td class="fw-medium">{{ producto.nombre }}</td>
                            <td data-value="{{ producto.precio }}">{{ producto.precio|number_format(2, ',', '.') }} €</td>
                            <td class="text-end pe-3">
                                <a href="{{ path('app_producto_show', {id: producto.id}) }}" class="btn btn-sm btn-outline-secondary" title="Ver">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="{{ path('app_producto_edit', {id: producto.id}) }}" class="btn btn-sm btn-outline-primary" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger" title="Borrar" data-bs-toggle="modal" data-bs-target="#deleteModal{{ producto.id }}">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                <i class="bi bi-box-seam fs-3 d-block mb-2"></i>
                                No hay productos todavía.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {% if totalPaginas > 1 %}
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    {% for i in 1..totalPaginas %}
                        <li class="page-item {{ i == paginaActual ? 'active' : '' }}">
                            <a class="page-link" href="{{ path('app_producto_index', {page: i}) }}">{{ i }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </nav>
        {% endif %}
    </div>

    {# Modales de confirmación de borrado: fuera de la tabla, como hijos directos del body,
       tal y como recomienda la documentación de Bootstrap #}
    {% for producto in productos %}
        <div class="modal fade" id="deleteModal{{ producto.id }}" tabindex="-1" aria-labelledby="deleteModalLabel{{ producto.id }}" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-body p-4 text-center">
                        <div class="rounded-circle bg-danger-subtle d-inline-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px;">
                            <i class="bi bi-trash text-danger fs-4"></i>
                        </div>
                        <h5 class="mb-2">¿Borrar «{{ producto.nombre }}»?</h5>
                        <p class="text-muted small mb-4">Esta acción no se puede deshacer.</p>
                        <div class="d-flex gap-2 justify-content-center">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <form method="post" action="{{ path('app_producto_delete', {id: producto.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ producto.id) }}">
                                <button class="btn btn-danger">Sí, borrar</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endfor %}

    <style>
        th.sortable { cursor: pointer; user-select: none; white-space: nowrap; }
        th.sortable:hover { background-color: #eee; }
        th.sortable i { font-size: 0.75em; vertical-align: middle; }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const tbody = document.getElementById('tabla-productos-body');
            const headers = document.querySelectorAll('th.sortable');

            headers.forEach(function (th) {
                th.addEventListener('click', function () {
                    const col = parseInt(th.dataset.col, 10);
                    const type = th.dataset.sort;
                    const asc = th.dataset.direction !== 'asc';

                    headers.forEach(function (h) {
                        delete h.dataset.direction;
                        h.querySelector('i').className = 'bi bi-arrow-down-up text-muted small';
                    });
                    th.dataset.direction = asc ? 'asc' : 'desc';
                    th.querySelector('i').className = asc
                        ? 'bi bi-arrow-up small'
                        : 'bi bi-arrow-down small';

                    const filas = Array.from(tbody.querySelectorAll('tr')).filter(function (tr) {
                        return tr.children.length > 1;
                    });

                    filas.sort(function (a, b) {
                        const celdaA = a.children[col];
                        const celdaB = b.children[col];
                        let valA = celdaA.dataset.value !== undefined ? celdaA.dataset.value : celdaA.textContent.trim();
                        let valB = celdaB.dataset.value !== undefined ? celdaB.dataset.value : celdaB.textContent.trim();

                        if (type === 'number') {
                            valA = parseFloat(valA) || 0;
                            valB = parseFloat(valB) || 0;
                            return asc ? valA - valB : valB - valA;
                        }

                        return asc
                            ? valA.localeCompare(valB, 'es', { sensitivity: 'base' })
                            : valB.localeCompare(valA, 'es', { sensitivity: 'base' });
                    });

                    filas.forEach(function (tr) { tbody.appendChild(tr); });
                });
            });
        });
    </script>
{% endblock %}