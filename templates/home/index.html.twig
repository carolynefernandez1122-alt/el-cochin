{% extends 'base.html.twig' %}

{% block title %}El Cochin - Tu tienda de abarrotes{% endblock %}

{% block body %}
    <div class="text-center text-white py-5" style="background: linear-gradient(135deg, #e8632b, #f2a33d);">
        <h1 class="display-4 fw-bold">Bienvenido a El Cochin 🐷</h1>
        <p class="lead">Productos frescos, precios justos, atención de barrio</p>
        <div class="d-flex justify-content-center mt-4">
            <form class="d-flex" style="max-width: 500px; width: 100%;" action="{{ path('app_producto_buscar') }}" method="get">
                <input class="form-control form-control-lg" style="border-radius: 30px 0 0 30px;" type="search" name="q" placeholder="¿Qué buscas hoy?">
                <button class="btn btn-light btn-lg fw-bold" style="border-radius: 0 30px 30px 0;" type="submit">Buscar</button>
            </form>
        </div>
    </div>

    <div class="container my-5">
        <h2 class="mb-4 fw-bold" style="color:#e8632b;">🔥 Productos Destacados</h2>
        <div class="row g-4">
            {% for producto in destacados %}
                <div class="col-6 col-md-3">
                    <div class="card h-100 shadow-sm border-0">
                        <img src="{{ producto.imagenUrl }}" class="card-img-top" alt="{{ producto.nombre }}" style="height:180px; object-fit:cover; border-radius:14px 14px 0 0;">
                        <div class="card-body">
                            <h6 class="card-title">{{ producto.nombre }}</h6>
                            <p class="fw-bold mb-0" style="color:#e8632b;">{{ producto.precio }} €</p>
                        </div>
                    </div>
                </div>
            {% else %}
                <p class="text-muted">Aún no hay productos marcados como destacados. Márcalos como <code>destacado = true</code> desde el panel de administración.</p>
            {% endfor %}
        </div>
    </div>

    <div class="container my-5">
        <h2 class="mb-4 fw-bold" style="color:#e8632b;">📦 Categorías</h2>
        <div class="row g-4">
            {% for categoria in categorias %}
                <div class="col-6 col-md-3">
                    <a href="{{ path('app_categoria_show', {id: categoria.id}) }}" class="text-decoration-none">
                        <div class="card text-center h-100 shadow-sm border-0 py-4">
                            <div style="font-size: 2.5rem;">🛒</div>
                            <h6 class="mt-2 text-dark">{{ categoria.nombre }}</h6>
                        </div>
                    </a>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}